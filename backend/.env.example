# Copy this file to .env and replace the URL with the one from Neon.
# Keep sslmode=require, which Neon needs for encrypted connections.
DATABASE_URL=postgresql://neondb_owner:npg_2nWLQqxFouj8@ep-silent-term-ayd0h5j1-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

DJANGO_SECRET_KEY=change-me-for-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_CONN_MAX_AGE=60

# SMTP email notifications for enquiries (example: Gmail SMTP with an app password)
CONTACT_RECIPIENT_EMAIL=hello@shotsbypato.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=your-email@gmail.com
